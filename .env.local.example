ANTHROPIC_API_KEY=your_api_key_here
RESEND_API_KEY=your_resend_api_key_here
FOUNDER_EMAIL=your_founder_email_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Vapi voice assistant sync (scripts/sync-vapi-assistant.js). Each client's
# assistant id is stored in chatbots.vapi_assistant_id, not an env var.
VAPI_PRIVATE_KEY=your_vapi_private_key_here

# Vapi save_booking tool webhook (app/api/vapi-webhook/route.js).
# VAPI_WEBHOOK_SECRET is NOT issued by Vapi — you invent this value yourself
# (e.g. `openssl rand -hex 32`) and the sync script configures it into the
# tool; Vapi echoes it back on every webhook call for you to verify.
VAPI_WEBHOOK_SECRET=your_own_random_secret_here
# Local dev: an ngrok/tunnel URL + /api/vapi-webhook. Production: your deployed domain + /api/vapi-webhook.
VAPI_WEBHOOK_URL=https://your-tunnel-or-domain.example.com/api/vapi-webhook
